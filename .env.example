# Copy this file to .env and fill in the two values below.
# Find both at https://octopus.energy/dashboard/new/accounts/personal-details/api-access
OCTOPUS_API_KEY=
OCTOPUS_ACCOUNT=

# Optional
# GAS_UNITS=auto        # auto | m3 | kWh  (SMETS2 gas meters report m³, SMETS1 report kWh)
# HISTORY_YEARS=3       # how far back the first download goes
# AUTO_SYNC_HOURS=6     # download new readings this often while the app is running
# PORT=5080
# DEMO=1                # force demo data even with a key set
